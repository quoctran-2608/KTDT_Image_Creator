# ==============================================================================
# KTDT Image Creator - Server-side Environment Configuration
# ==============================================================================
# LƯU Ý BẢO MẬT & HẠ TẦNG:
# 1. Toàn bộ các biến này là cấu hình SERVER-SIDE của OWNER ứng dụng.
# 2. Người dùng cuối truy cập qua trình duyệt KHÔNG cần và KHÔNG cấu hình các biến này.
# 3. Production Cloud Run ưu tiên sử dụng Cloud Run service identity / Application Default Credentials (ADC).
# 4. Production thông thường KHÔNG cần service-account JSON nếu quyền IAM trên Google Cloud đã được cấp đúng.
# 5. EDITORIAL_EXPORT_BUCKET chỉ là tên bucket (ví dụ: my-ktdt-export-bucket), KHÔNG dùng định dạng gs:// URL.
# 6. Production KHÔNG dùng Gemini API Key; toàn bộ việc phân tích và tạo ảnh sử dụng Vertex AI qua ADC của Owner.
# ==============================================================================

# Cấu hình Google Cloud Vertex AI (Bắt buộc trên Production - Quản lý bởi Owner)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.1-flash-image

# Google Cloud Storage Bucket cho một chiều xuất gói KTDT_IMAGE_PACK v1 sang Editorial
# Chỉ nhập tên bucket thuần túy, không có tiền tố "gs://"
EDITORIAL_EXPORT_BUCKET=

# Khóa API Gemini tùy chọn (CHỈ dùng làm fallback cho local dev / preview nếu không kết nối GCP; Production KHÔNG sử dụng)
GEMINI_API_KEY=

# Tùy chọn xác thực cục bộ/dev (không bắt buộc trên Cloud Run với IAM ADC)
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_SERVICE_ACCOUNT_JSON=
